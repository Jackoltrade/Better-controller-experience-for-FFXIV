<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.6.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(DALAMUD_HOME)</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Dalamud"><HintPath>$(DalamudLibPath)/Dalamud.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(DalamudLibPath)/Dalamud.Bindings.ImGui.dll</HintPath><Private>false</Private></Reference>
    <None Update="DualSenseLighting.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets/dualsense-preview.svg" LogicalName="DualSenseLighting.Assets.dualsense-preview.svg" />
    <EmbeddedResource Include="Assets/dualsense-preview.png" LogicalName="DualSenseLighting.Assets.dualsense-preview.png" />
    <EmbeddedResource Include="Assets/dualsense-preview-lightbar.png" LogicalName="DualSenseLighting.Assets.dualsense-preview-lightbar.png" />
  </ItemGroup>
  <Target Name="CheckDalamudPath" BeforeTargets="ResolveReferences" Condition="!Exists('$(DalamudLibPath)/Dalamud.dll')">
    <Error Text="Set DALAMUD_HOME or pass -p:DalamudLibPath to the directory containing Dalamud.dll (API 15)." />
  </Target>
</Project>
