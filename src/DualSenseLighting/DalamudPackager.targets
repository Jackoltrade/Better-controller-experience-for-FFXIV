<Project>
  <PropertyGroup>
    <ControllerMakeZip>false</ControllerMakeZip>
    <ControllerMakeZip Condition="'$(Configuration)' == 'Release' And '$(EnableDiagnostics)' != 'true'">true</ControllerMakeZip>
  </PropertyGroup>
  <!-- Keep framework assemblies, symbols, runtime configs and local diagnostic
       recordings out of the installer. Images use Packager's standard sidecar. -->
  <Target Name="PackageControllerPlugin" AfterTargets="Build">
    <DalamudPackager ProjectDir="$(ProjectDir)"
                    OutputPath="$(OutputPath)"
                    AssemblyName="$(AssemblyName)"
                    ManifestType="json"
                    MakeZip="$(ControllerMakeZip)"
                    Include="$(AssemblyName).dll;$(AssemblyName).json;LICENSE.txt;LICENSE-HidLibrary.txt;LICENSE-FFXIVClientStructs.txt;THIRD-PARTY-NOTICES.txt" />
  </Target>
</Project>
