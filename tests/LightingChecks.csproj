<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>LightingChecks</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../src/DualSenseLighting/Assets/dualsense-preview.svg" LogicalName="DualSenseLighting.Assets.dualsense-preview.svg" />
    <EmbeddedResource Include="../src/DualSenseLighting/Assets/dualsense-preview.png" LogicalName="DualSenseLighting.Assets.dualsense-preview.png" />
    <EmbeddedResource Include="../src/DualSenseLighting/Assets/dualsense-preview-lightbar.png" LogicalName="DualSenseLighting.Assets.dualsense-preview-lightbar.png" />
    <Compile Include="../src/DualSenseLighting/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../src/DualSenseLighting/Windows/Native.cs" Link="Windows/Native.cs" />
    <Compile Include="../src/DualSenseLighting/Windows/HidDevices.cs" Link="Windows/HidDevices.cs" />
    <Compile Include="../src/DualSenseLighting/Windows/SteamInstallation.cs" Link="Windows/SteamInstallation.cs" />
  </ItemGroup>
</Project>
